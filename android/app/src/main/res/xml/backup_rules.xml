<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. The Explain API key is encrypted with a key that
     never leaves this device, so a restored copy could not be read. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
</full-backup-content>
